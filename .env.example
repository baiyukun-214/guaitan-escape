# Copy to .env; leave AI values empty for explicit offline play. Never put secrets in VITE_*.
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Explicit opt-in to send submitted text/earned clues to your chosen provider:
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
# Dev seat switch sandbox, disabled automatically when NODE_ENV=production
DEV_PLAY=true
# Optional comma-separated origins, required for a separate frontend origin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
